FROM node:20-alpine AS builder
WORKDIR /app

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID

# Feature flags are inlined into the client bundle at build time ("1" = on).
# Unset or "0" keeps the pre-refactor behaviour. Changing one needs a new image.
ARG NEXT_PUBLIC_FEATURE_TRANSFERS=0
ARG NEXT_PUBLIC_FEATURE_SAVING_FUND=0
ARG NEXT_PUBLIC_FEATURE_PERIOD_PLANNING=0
ARG NEXT_PUBLIC_FEATURE_SHARING_V2=0
ARG NEXT_PUBLIC_FEATURE_UI_REFRESH=0
ARG NEXT_PUBLIC_FEATURE_DEBT_V2=0
ENV NEXT_PUBLIC_FEATURE_TRANSFERS=$NEXT_PUBLIC_FEATURE_TRANSFERS \
    NEXT_PUBLIC_FEATURE_SAVING_FUND=$NEXT_PUBLIC_FEATURE_SAVING_FUND \
    NEXT_PUBLIC_FEATURE_PERIOD_PLANNING=$NEXT_PUBLIC_FEATURE_PERIOD_PLANNING \
    NEXT_PUBLIC_FEATURE_SHARING_V2=$NEXT_PUBLIC_FEATURE_SHARING_V2 \
    NEXT_PUBLIC_FEATURE_UI_REFRESH=$NEXT_PUBLIC_FEATURE_UI_REFRESH \
    NEXT_PUBLIC_FEATURE_DEBT_V2=$NEXT_PUBLIC_FEATURE_DEBT_V2

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

EXPOSE 3000

CMD ["node", "server.js"]
